+/*
+ * SHADOWGUN build: VCMP/VCMPE.F32 without softfloat. The relation is read straight off the bit patterns
+ * (sign-magnitude to two's complement, so -0 == +0 and denormals compare exactly, as without flush-to-zero),
+ * independent of the host FPCR. Like the other fast VFP paths the cumulative flags (IOC for a NaN) are not
+ * produced; flush-inputs-to-zero guests and QEMU_STRICT_FP=1 keep the softfloat path.
+ */
+static inline void vfp_cmp_s_fast(float32 a, float32 b, CPUARMState *env, bool exc)
+{
+    float_status *st = &env->vfp.fp_status[FPST_A32];
+    uint32_t flags;
+
+    if (unlikely(st->flush_inputs_to_zero) || unlikely(vfp_strict_fp)) {
+        softfloat_to_vfp_compare(env, exc ? float32_compare(a, b, st) : float32_compare_quiet(a, b, st));
+        return;
+    }
+    if (unlikely((a & 0x7fffffffu) > 0x7f800000u || (b & 0x7fffffffu) > 0x7f800000u)) {
+        flags = 0x3;                                        /* unordered */
+    } else {
+        int32_t ka = (a & 0x80000000u) ? -(int32_t)(a & 0x7fffffffu) : (int32_t)a;
+        int32_t kb = (b & 0x80000000u) ? -(int32_t)(b & 0x7fffffffu) : (int32_t)b;
+        flags = ka == kb ? 0x6 : ka < kb ? 0x8 : 0x2;
+    }
+    env->vfp.fpsr = deposit64(env->vfp.fpsr, 28, 4, flags); /* NZCV */
+}
+
+void VFP_HELPER(cmp, s)(float32 a, float32 b, CPUARMState *env)
+{
+    vfp_cmp_s_fast(a, b, env, false);
+}
+
+void VFP_HELPER(cmpe, s)(float32 a, float32 b, CPUARMState *env)
+{
+    vfp_cmp_s_fast(a, b, env, true);
+}
