+/*
+ * SHADOWGUN build: VCMP/VCMPE.F32 as plain TCG ops. The relation is read off the bit patterns (sign-magnitude to
+ * two's complement: -0 == +0, denormals compare exactly, as without flush-to-zero) and written to FPSCR[31:28]
+ * with no helper call - a call cost more than the compare itself. The cumulative flags (IOC for a NaN) are not
+ * produced, like the other fast VFP paths; QEMU_STRICT_FP=1 keeps the softfloat helpers. Guests that set
+ * FPSCR.FZ would differ on denormal inputs (this game does not).
+ */
+static bool vcmp_inline_ok = true;
+
+static void __attribute__((constructor)) vcmp_inline_init(void)
+{
+    const char *v = getenv("QEMU_STRICT_FP");
+    vcmp_inline_ok = !(v && *v && *v != '0');
+}
+
+static void gen_vcmp_s_inline(TCGv_i32 a, TCGv_i32 b)
+{
+    TCGv_i32 aa = tcg_temp_new_i32(), ab = tcg_temp_new_i32();
+    TCGv_i32 ka = tcg_temp_new_i32(), kb = tcg_temp_new_i32();
+    TCGv_i32 t = tcg_temp_new_i32(), f = tcg_temp_new_i32(), u = tcg_temp_new_i32();
+    TCGv_i32 zero = tcg_constant_i32(0);
+
+    tcg_gen_andi_i32(aa, a, 0x7fffffff);
+    tcg_gen_andi_i32(ab, b, 0x7fffffff);
+    tcg_gen_neg_i32(t, aa);
+    tcg_gen_movcond_i32(TCG_COND_LT, ka, a, zero, t, aa);
+    tcg_gen_neg_i32(t, ab);
+    tcg_gen_movcond_i32(TCG_COND_LT, kb, b, zero, t, ab);
+
+    tcg_gen_movi_i32(f, 0x2);                                       /* greater */
+    tcg_gen_movcond_i32(TCG_COND_LT, f, ka, kb, tcg_constant_i32(0x8), f);
+    tcg_gen_movcond_i32(TCG_COND_EQ, f, ka, kb, tcg_constant_i32(0x6), f);
+    tcg_gen_setcondi_i32(TCG_COND_GTU, u, aa, 0x7f800000);          /* either a NaN: unordered */
+    tcg_gen_setcondi_i32(TCG_COND_GTU, t, ab, 0x7f800000);
+    tcg_gen_or_i32(u, u, t);
+    tcg_gen_movcond_i32(TCG_COND_NE, f, u, zero, tcg_constant_i32(0x3), f);
+
+    tcg_gen_shli_i32(f, f, 28);
+    tcg_gen_ld_i32(t, tcg_env, offsetoflow32(CPUARMState, vfp.fpsr));
+    tcg_gen_andi_i32(t, t, 0x0fffffff);
+    tcg_gen_or_i32(t, t, f);
+    tcg_gen_st_i32(t, tcg_env, offsetoflow32(CPUARMState, vfp.fpsr));
+}
